{
  "name": "@dudousxd/nestjs-catalog-dashboard",
  "version": "0.1.0",
  "description": "The catalog console for @dudousxd/nestjs-catalog: model, objects, query, dashboards, connectors, workflows, lineage, activity and access, served as a mountable NestJS module.",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavideCarvalho/nestjs-catalog.git",
    "directory": "packages/dashboard"
  },
  "keywords": [
    "nestjs",
    "catalog",
    "dashboard",
    "console",
    "ontology"
  ],
  "type": "module",
  "main": "./dist/server/index.cjs",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./client": {
      "types": "./dist/client/durable-client.d.ts",
      "import": "./dist/client/durable-client.js",
      "default": "./dist/client/durable-client.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsup",
    "typecheck": "tsc -p tsconfig.server.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/core": "11.1.19",
    "@types/node": "25.6.0",
    "typescript": "5.9.3",
    "tsup": "8.3.5",
    "@dudousxd/nestjs-catalog-react": "workspace:*",
    "@tanstack/react-query": "5.62.7",
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "vite": "6.0.3",
    "tailwindcss": "4.2.4",
    "@tailwindcss/vite": "4.2.4",
    "tailwindcss-animate": "1.0.7"
  }
}
