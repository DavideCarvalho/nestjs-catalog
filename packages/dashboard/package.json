{
  "name": "@dudousxd/nestjs-catalog-dashboard",
  "version": "0.34.0",
  "description": "The catalog console for @dudousxd/nestjs-catalog: model, objects, query, dashboards, connectors, workflows, lineage, activity and access, served as a mountable NestJS module.",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavideCarvalho/nestjs-catalog.git",
    "directory": "packages/dashboard"
  },
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-catalog/issues"
  },
  "keywords": [
    "nestjs",
    "catalog",
    "dashboard",
    "console",
    "ontology"
  ],
  "type": "module",
  "main": "./dist/server/index.cjs",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./client": {
      "types": "./dist/client/console-session.d.ts",
      "import": "./dist/client/console-session.js",
      "default": "./dist/client/console-session.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsup && tsc -p tsconfig.react.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "react": ">=18"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/core": "11.1.19",
    "@types/node": "25.9.7",
    "typescript": "5.9.3",
    "tsup": "8.5.1",
    "@dudousxd/nestjs-catalog-react": "workspace:*",
    "@tanstack/react-query": "5.103.1",
    "@vitejs/plugin-react": "4.7.0",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "vite": "6.4.3",
    "tailwindcss": "4.2.4",
    "@tailwindcss/vite": "4.2.4",
    "tailwindcss-animate": "1.0.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
